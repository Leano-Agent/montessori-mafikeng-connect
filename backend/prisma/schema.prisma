// Prisma Schema for Montessori Mafikeng Connect
// African Montessori School Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User roles
enum UserRole {
  TEACHER
  PARENT
  ADMIN
  PRINCIPAL
}

// Language preferences
enum LanguagePreference {
  SETSWANA
  ENGLISH
}

// Montessori observation areas
enum MontessoriArea {
  PRACTICAL_LIFE
  SENSORIAL
  LANGUAGE
  MATHEMATICS
  CULTURE
  ART
  MUSIC
}

// Communication types
enum CommunicationType {
  ANNOUNCEMENT
  MESSAGE
  EMERGENCY
  HOMEWORK
  EVENT
}

// Recipient types
enum RecipientType {
  INDIVIDUAL
  CLASSROOM
  SCHOOL
  PARENT_GROUP
}

// Attendance status
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// Event types
enum EventType {
  SCHOOL_EVENT
  PARENT_TEACHER
  VOLUNTEER
  FUNDRAISER
  HOLIDAY
}

// Material condition
enum MaterialCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BROKEN
}

// User model
model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  phone               String?             @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole
  languagePreference  LanguagePreference  @default(SETSWANA)
  avatarUrl           String?
  isActive            Boolean             @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  // Relations
  taughtClassrooms    Classroom[]         @relation("TeacherClassrooms")
  assistedClassrooms  Classroom[]         @relation("AssistantTeacherClassrooms")
  primaryStudents     Student[]           @relation("PrimaryParent")
  secondaryStudents   Student[]           @relation("SecondaryParent")
  observations        MontessoriObservation[]
  sentCommunications  Communication[]     @relation("Sender")
  attendanceNotes     Attendance[]        @relation("NotedBy")
  organizedEvents     Event[]             @relation("Organizer")
  volunteerSignups    EventVolunteer[]
  auditLogs           AuditLog[]
  materialUsage       MaterialUsage[]
  
  @@index([email])
  @@index([role])
  @@index([isActive])
}

// Student model (Montessori learners)
model Student {
  id                    String              @id @default(uuid())
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String?
  enrollmentDate        DateTime
  classroomId           String?
  primaryParentId       String?
  secondaryParentId     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?             // Encrypted at application level
  photoUrl              String?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  classroom             Classroom?          @relation(fields: [classroomId], references: [id])
  primaryParent         User?               @relation("PrimaryParent", fields: [primaryParentId], references: [id])
  secondaryParent       User?               @relation("SecondaryParent", fields: [secondaryParentId], references: [id])
  observations          MontessoriObservation[]
  attendance            Attendance[]
  materialUsage         MaterialUsage[]
  
  @@index([classroomId])
  @@index([primaryParentId])
  @@index([isActive])
  @@unique([firstName, lastName, dateOfBirth])
}

// Classroom model (Montessori mixed-age)
model Classroom {
  id                  String    @id @default(uuid())
  name                String    // e.g., "3-6 Age Group"
  ageRange            String    // e.g., "3-6", "6-9", "9-12"
  teacherId           String?
  assistantTeacherId  String?
  capacity            Int       @default(25)
  currentEnrollment   Int       @default(0)
  roomNumber          String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Relations
  teacher             User?     @relation("TeacherClassrooms", fields: [teacherId], references: [id])
  assistantTeacher    User?     @relation("AssistantTeacherClassrooms", fields: [assistantTeacherId], references: [id])
  students            Student[]
  communications      Communication[] @relation("ClassroomCommunications")
  
  @@index([teacherId])
  @@index([ageRange])
  @@index([isActive])
}

// Montessori Observations (Core Feature)
model MontessoriObservation {
  id                    String          @id @default(uuid())
  studentId             String
  teacherId             String
  area                  MontessoriArea
  subArea               String?
  observationText       String
  observationVoiceUrl   String?
  photos                String[]        // Array of photo URLs
  milestoneAchieved     Boolean         @default(false)
  milestoneDescription  String?
  workCycleDuration     Int?            // Minutes
  concentrationLevel    Int?            @default(3) // 1-5 scale
  materialsUsed         String[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  // Relations
  student               Student         @relation(fields: [studentId], references: [id])
  teacher               User            @relation(fields: [teacherId], references: [id])
  
  @@index([studentId, area])
  @@index([createdAt])
  @@index([teacherId])
}

// Communications model
model Communication {
  id                    String            @id @default(uuid())
  senderId              String
  recipientType         RecipientType
  recipientId           String?           // Could be user_id, classroom_id, or NULL for school-wide
  messageType           CommunicationType
  subject               String?
  messageText           String
  messageVoiceUrl       String?
  attachments           String[]          // Array of file URLs
  priority              Int               @default(1) // 1-3 scale, 3 = emergency
  isScheduled           Boolean           @default(false)
  scheduledFor          DateTime?
  requiresSmsFallback   Boolean           @default(false)
  smsSent               Boolean           @default(false)
  smsDelivered          Boolean           @default(false)
  readReceiptCount      Int               @default(0)
  createdAt             DateTime          @default(now())
  sentAt                DateTime?
  expiresAt             DateTime?         // For time-sensitive messages
  
  // Relations
  sender                User              @relation("Sender", fields: [senderId], references: [id])
  classroomRecipient    Classroom?        @relation("ClassroomCommunications", fields: [recipientId], references: [id])
  
  @@index([recipientType, recipientId])
  @@index([isScheduled, scheduledFor])
  @@index([priority])
  @@index([createdAt])
}

// Attendance model
model Attendance {
  id            String            @id @default(uuid())
  studentId     String
  date          DateTime
  status        AttendanceStatus
  checkInTime   DateTime?
  checkOutTime  DateTime?
  absenceReason String?
  notedById     String?
  notes         String?
  createdAt     DateTime          @default(now())
  
  // Relations
  student       Student           @relation(fields: [studentId], references: [id])
  notedBy       User?             @relation("NotedBy", fields: [notedById], references: [id])
  
  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([date, status])
}

// Events model
model Event {
  id                String      @id @default(uuid())
  title             String
  description       String?
  eventType         EventType
  startTime         DateTime
  endTime           DateTime
  location          String?
  organizerId       String?
  maxVolunteers     Int?
  currentVolunteers Int         @default(0)
  isPublished       Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  // Relations
  organizer         User?       @relation("Organizer", fields: [organizerId], references: [id])
  volunteers        EventVolunteer[]
  
  @@index([startTime])
  @@index([eventType])
  @@index([isPublished])
}

// Event Volunteers model
model EventVolunteer {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String?
  confirmed Boolean  @default(false)
  attended  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  
  // Relations
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Montessori Materials model
model MontessoriMaterial {
  id                    String            @id @default(uuid())
  name                  String
  description           String?
  area                  MontessoriArea
  subArea               String?
  ageRange              String?           // e.g., "3-6", "6-9"
  quantityAvailable     Int               @default(1)
  quantityTotal         Int               @default(1)
  location              String?
  condition             MaterialCondition @default(GOOD)
  lastMaintenanceDate   DateTime?
  nextMaintenanceDate   DateTime?
  isAvailable           Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  
  // Relations
  usageRecords          MaterialUsage[]
  
  @@index([area])
  @@index([isAvailable])
  @@index([condition])
}

// Material Usage model
model MaterialUsage {
  id              String            @id @default(uuid())
  materialId      String
  studentId       String?
  teacherId       String
  checkOutTime    DateTime
  checkInTime     DateTime?
  conditionBefore MaterialCondition?
  conditionAfter  MaterialCondition?
  notes           String?
  createdAt       DateTime          @default(now())
  
  // Relations
  material        MontessoriMaterial @relation(fields: [materialId], references: [id])
  student         Student?           @relation(fields: [studentId], references: [id])
  teacher         User               @relation(fields: [teacherId], references: [id])
  
  @@index([materialId])
  @@index([checkOutTime])
  @@index([checkInTime])
}

// Sync Queue for offline-first architecture
model SyncQueue {
  id          String   @id @default(uuid())
  endpoint    String
  method      String   // POST, PUT, DELETE
  payload     Json
  retryCount  Int      @default(0)
  lastRetry   DateTime?
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
}

// Audit Log for security and compliance
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entityType  String?
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  // Relations
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
}