# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_WS_URL=ws://localhost:3001

# App Configuration
VITE_APP_NAME="Montessori Mafikeng Connect"
VITE_APP_VERSION="0.1.0"
VITE_APP_DESCRIPTION="A culturally-relevant, Montessori-aligned school management platform for African Montessori schools"

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_VOICE_MESSAGES=true
VITE_ENABLE_SMS_INTEGRATION=true

# PWA Configuration
VITE_PWA_NAME="Montessori Mafikeng Connect"
VITE_PWA_SHORT_NAME="MM Connect"
VITE_PWA_THEME_COLOR="#2D3748"
VITE_PWA_BACKGROUND_COLOR="#FFFFFF"

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_SENTRY_DSN=""

# Development
VITE_DEBUG_MODE=false
VITE_MOCK_API=false